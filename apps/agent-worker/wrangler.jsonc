{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracebench-agent-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "RunAgent",
        "class_name": "RunAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RunAgent"]
    }
  ]
}
